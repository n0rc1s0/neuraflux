# NeuraFlux — Variabili d'Ambiente
# ─────────────────────────────────────────────────────────────
# Copia questo file come .env e riempilo con i tuoi valori.
# NON committare mai il file .env su GitHub!
# Il .gitignore già lo esclude.
# ─────────────────────────────────────────────────────────────

# ── GEMINI API KEY (obbligatoria) ─────────────────────────────
# Ottienila gratis su: https://aistudio.google.com/app/apikey
# Usata da Fluxy (assistente). Il Generatore può usare la chiave
# personale dell'utente salvata in localStorage.
GEMINI_KEY=AIza_LA_TUA_CHIAVE_QUI

# ── VERCEL TOKEN (opzionale — solo per deploy automatico) ─────
# Ottienilo su: https://vercel.com/account/tokens
# Senza questo token, il deploy funziona in modalità "Link Demo" locale.
VERCEL_TOKEN=

# ── VERCEL TEAM ID (opzionale — solo se usi un team Vercel) ───
VERCEL_TEAM_ID=

# ── SUPABASE (opzionale — per auth e salvataggio progetti cloud) ──
# Se non configurato, i progetti vengono salvati solo in localStorage.
SUPABASE_URL=
SUPABASE_ANON_KEY=
